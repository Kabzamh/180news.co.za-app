{
  "name": "180news",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/published.mjs && npm run build:api && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:api": "esbuild src/server/feed.ts src/server/iec.ts --bundle --platform=node --format=esm --target=node20 --outdir=api --log-level=warning",
    "snapshot": "esbuild scripts/snapshot.ts --bundle --platform=node --format=esm --target=node20 --outfile=node_modules/.tmp/snapshot.mjs --log-level=warning && node node_modules/.tmp/snapshot.mjs",
    "snapshot:iec": "esbuild scripts/iec-snapshot.ts --bundle --platform=node --format=esm --target=node20 --outfile=node_modules/.tmp/iec-snapshot.mjs --log-level=warning && node node_modules/.tmp/iec-snapshot.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "framer-motion": "^12.35.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}