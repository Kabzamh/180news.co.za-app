{
  // Diagnostic check for every source file, including historical modules not
  // imported by the current browser application. This currently reports
  // pre-existing errors and is intentionally separate from the Vite build.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.all.tsbuildinfo"
  },
  "include": ["src"]
}
